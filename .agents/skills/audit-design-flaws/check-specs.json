{
  "_comment": [
    "Which files each audit check applies to. Read by .claude/skills/state-tools/state-engine.py,",
    "which is vendored from devkit and therefore cannot know this project's source layout.",
    "",
    "These globs were inlined in the engine as CHECK_SPECS until the engine was vendored;",
    "they are Carameli's app/ + frontend/src/ tree and belong here, not upstream.",
    "",
    "Changing a check's `include` or `kind` changes its checkSignature, which forces a full",
    "rescan of that check. That is intended - but it discards the accumulated pass/fixed",
    "statuses for it, so do not reshuffle these casually.",
    "",
    "`kind`: local = each file is judged on its own; cross = the check needs a project-wide",
    "fact table, so the plan sets rebuildFacts when anything in scope moved."
  ],
  "exclude_prefixes": ["alembic/versions/"],
  "checks": [
    {
      "id": "A",
      "kind": "local",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "B",
      "kind": "cross",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "C",
      "kind": "cross",
      "include": ["frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "D",
      "kind": "cross",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "E",
      "kind": "local",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "F",
      "kind": "local",
      "include": ["frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "G",
      "kind": "local",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "H",
      "kind": "local",
      "include": ["frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "I",
      "kind": "local",
      "include": ["tests/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    },
    {
      "id": "J",
      "kind": "cross",
      "include": ["tests/test_*.py", "tests/**/test_*.py"]
    },
    {
      "id": "K",
      "kind": "cross",
      "include": [
        "app/services/**/*.py",
        "app/repositories/**/*.py",
        "frontend/src/hooks/**/*.ts",
        "frontend/src/hooks/**/*.tsx",
        "frontend/src/lib/**/*.ts",
        "frontend/src/lib/**/*.tsx"
      ]
    },
    {
      "id": "L",
      "kind": "local",
      "include": ["app/**/*.py", "frontend/src/**/*.ts", "frontend/src/**/*.tsx"]
    }
  ]
}
