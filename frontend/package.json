{
  "name": "carameli-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "gen:phone-metadata": "node phoneMetadataGen.ts",
    "test": "vitest",
    "test:run": "vitest run",
    "test:bundle": "npm run build && vitest run --config vitest.bundle.config.ts",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:css && npm run lint:spelling && npm run lint:deadweight",
    "lint:deadweight": "knip",
    "lint:eslint": "eslint src --ext .js,.jsx,.ts,.tsx --format stylish",
    "lint:types": "tsc --noEmit --pretty false && tsc -p tsconfig.node.json --pretty false",
    "lint:css": "stylelint \"src/**/*.css\" --formatter unix",
    "lint:spelling": "cspell \"../**/*.md\" \"src/**/*.{ts,tsx,js,jsx,json,yml,yaml}\" --no-progress --relative"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "framer-motion": "^13.5.1",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^1.55.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "sip.js": "^0.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/ui": "^4.1.11",
    "cspell": "^10.3.6",
    "eslint": "^10.12.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "jsdom": "^30.1.2",
    "knip": "^6.41.0",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.29",
    "sharp": "^0.35.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
