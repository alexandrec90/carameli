{
  "name": "carameli-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:css && npm run lint:spelling",
    "lint:eslint": "eslint src --ext .js,.jsx,.ts,.tsx --format stylish",
    "lint:types": "tsc --noEmit --pretty false",
    "lint:css": "stylelint \"src/**/*.css\" --formatter unix",
    "lint:spelling": "cspell \"../**/*.md\" \"src/**/*.{ts,tsx,js,jsx,json,yml,yaml}\" --no-progress --relative"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.2.8",
    "@react-spring/three": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "framer-motion": "^12.34.3",
    "lucide-react": "^0.462.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^6.26.2",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/ui": "^4.1.9",
    "autoprefixer": "^10.4.20",
    "cspell": "^8.18.1",
    "eslint": "^9.23.0",
    "eslint-import-resolver-typescript": "^4.3.5",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.10.6",
    "jsdom": "^29.1.1",
    "markdownlint-cli": "^0.48.0",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.27.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.9"
  }
}
