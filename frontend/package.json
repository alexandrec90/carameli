{
  "name": "carameli-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "npm run lint:eslint && npm run lint:types && npm run lint:css && npm run lint:spelling",
    "lint:eslint": "eslint src --ext .js,.jsx,.ts,.tsx --format stylish",
    "lint:types": "tsc --noEmit --pretty false",
    "lint:css": "stylelint \"src/**/*.css\" --formatter unix",
    "lint:spelling": "cspell \"../**/*.md\" \"src/**/*.{ts,tsx,js,jsx,json,yml,yaml}\" --no-progress --relative"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.5",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sip.js": "^0.21.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/ui": "^4.1.9",
    "cspell": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.6",
    "jsdom": "^29.1.1",
    "markdownlint-cli": "^0.49.1",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    },
    "eslint-plugin-react": {
      "eslint": "$eslint"
    }
  }
}
