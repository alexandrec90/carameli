# npm treats `engines` as advice by default: a package whose `engines.node` excludes the
# running interpreter installs anyway, with an EBADENGINE warning in a wall of install
# output, and fails later at the point of use. That is how cspell 10.3.0 (`>=22.18.0`)
# landed on a repo pinned to Node 20 and took out `npm run lint`'s spelling step without
# anything going red -- see tests/unit/test_node_version_pin.py.
#
# `engine-strict` promotes that warning to an install error naming the offending package,
# which makes `npm ci` itself the check. It covers the whole tree and every future bump,
# so it does not need updating when a dependency raises its floor.
engine-strict=true
