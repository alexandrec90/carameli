{
  "env": {
    "CLAUDE_CODE_ENABLE_TELEMETRY": "1",
    "OTEL_METRICS_EXPORTER": "otlp",
    "OTEL_LOGS_EXPORTER": "otlp",
    "OTEL_EXPORTER_OTLP_PROTOCOL": "http/protobuf",
    "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318",
    "OTEL_METRIC_EXPORT_INTERVAL": "10000",
    "OTEL_LOGS_EXPORT_INTERVAL": "5000"
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Edit(*)",
      "Write(*)",
      "WebFetch(*)",
      "Grep(*)",
      "Glob(*)",
      "LS(*)",
      "MultiEdit(*)",
      "NotebookRead(*)",
      "NotebookEdit(*)",
      "TodoRead(*)",
      "TodoWrite(*)",
      "WebSearch(*)",
      "Edit(/.claude/skills/audit-design-flaws/**)",
      "Edit(/.claude/skills/state-tools/**)",
      "Edit(/.claude/skills/make-tests/**)",
      "Edit(/.claude/skills/make-frontend-tests/**)",
      "Edit(/.claude/skills/refactor/**)",
      "Bash(cp .claude/skills/audit-design-flaws/state.json /tmp/_state-audit.json)",
      "Bash(cp .claude/skills/make-tests/state.json /tmp/_state-make-tests.json)",
      "Bash(cp .claude/skills/make-frontend-tests/state.json /tmp/_state-make-frontend-tests.json)",
      "Bash(cp .claude/skills/refactor/state.json /tmp/_state-refactor.json)",
      "Edit(/.claude/skills/plan-handoff/**)",
      "Edit(/.claude/skills/check-boundaries/**)",
      "Edit(/.claude/skills/check-logging/**)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx eslint *)",
      "PowerShell(& \"frontend\\\\node_modules\\\\.bin\\\\cspell.cmd\" --config frontend\\\\cspell.config.yaml --no-progress --relative \"docs/prototype-roadmap.md\" \"README.md\" \"todo.md\")"
    ],
    "defaultMode": "bypassPermissions",
    "additionalDirectories": [
      "C:\\Users\\Administrator\\.claude",
      "c:\\Users\\Administrator\\Desktop\\vs_code\\carameli\\.claude\\skills\\state-tools"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/session-start.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/enforce-capped-bash.py\""
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/pretool.py\""
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUseFailure\",\"additionalContext\":\"Failure retro (project policy): if this tool failure traces to an instruction file (a skill, rule, or CLAUDE.md prescribing a wrong command, stale path, or missing guard), flag it with the exact file and line and a proposed edit in your final report - do not just work around it. Routine exploratory failures need no mention.\"},\"suppressOutput\":true}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Skill$",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"Skill retro (project policy): before your final report, check whether any step of this skill run failed, no-oped, or wasted an operation because of how the skill/rule markdown is written. If so, flag it to the user with the exact file and line and a proposed edit - never silently work around bad instructions.\"},\"suppressOutput\":true}'"
          }
        ]
      },
      {
        "matcher": "^(Edit|Write|MultiEdit|apply_patch|create_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/skills/add-db-model/after-model-edit.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/scripts/hooks/stop.py\""
          }
        ]
      }
    ]
  },
  "effortLevel": "high",
  "defaultModel": "opus"
}
