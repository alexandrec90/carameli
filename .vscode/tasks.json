      "problemMatcher": []
    },
    {
      "label": "Start: Frontend + Preview",
      "detail": "Dev server and Simple Browser preview together. This is the one to run for frontend work.",
      "dependsOn": [
        "Start: Frontend Dev Server",
        "Open: Frontend Preview (Simple Browser)"
