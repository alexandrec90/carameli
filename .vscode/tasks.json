    {
      "label": "Eval: Instruction Files (promptfoo)",
      "detail": "COSTS CREDITS. Pick the run: full graded sweep, a 3-case sample, repeat-3 for stability, or one of the fix-tests optimization runs (whole-skill ablation, concise-rewrite A/B, or a single-section ablation). Budget caps are set per mode via EVAL_MAX_USD.",
      "type": "process",
      "command": "python",
      "args": [
        "scripts/notify-wrap.py", "Eval: Instruction Files", "--",
        "pwsh", "-ExecutionPolicy", "Bypass", "-Command",
        "$env:EVAL_MAX_USD = '6'; switch ('${input:evalMode}') { 'full' { $env:EVAL_MAX_USD = '8'; npm run eval; $e = $LASTEXITCODE; npm run eval:summary; exit $e } 'quick' { $env:EVAL_MAX_USD = '5'; npm run eval:quick; exit $LASTEXITCODE } 'stable' { npm run eval:stable; $e = $LASTEXITCODE; npm run eval:summary; exit $e } 'ablate' { npm run eval:ablate -- .claude/skills/fix-tests; exit $LASTEXITCODE } 'rewrite' { npm run eval:rewrite -- .claude/skills/fix-tests/SKILL.md evals/rewrites/fix-tests-concise/SKILL.md; exit $LASTEXITCODE } 'section-known-fix' { npm run eval:section -- .claude/skills/fix-tests/SKILL.md 'Known-fix matching'; exit $LASTEXITCODE } 'section-log-quality' { npm run eval:section -- .claude/skills/fix-tests/SKILL.md 'Log quality gate'; exit $LASTEXITCODE } }"
      ],
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "close": false
