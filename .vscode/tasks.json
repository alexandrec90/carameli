{
  // Keep this palette small. Shared quality, git, agent-context, Docker-maintenance,
  // port, and shipping actions live in alex-projects.code-workspace. This file is
  // only for Carameli workflows where a VS Code picker/composite adds real value.
  // One-off administration remains available through the documented scripts.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start: Full Stack (Docker Compose)",
      "detail": "Build and start the Carameli stack, then wait for healthchecks. The default build task (Ctrl+Shift+B).",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Start: Full Stack", "--", "python", "scripts/docker-up.py", "--build"],
      "group": { "kind": "build", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "new", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Start: Frontend Dev Server",
      "detail": "Implementation step for 'Start: Frontend + Preview'; hidden from the task picker.",
      "hide": true,
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "presentation": { "reveal": "always", "panel": "new", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Open: Frontend Preview",
      "detail": "Implementation step for 'Start: Frontend + Preview'; hidden from the task picker.",
      "hide": true,
      "type": "shell",
      "command": "echo ${input:openFrontendSimpleBrowser}",
      "presentation": { "reveal": "silent", "panel": "dedicated", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Start: Frontend + Preview",
      "detail": "Start Vite with HMR and open localhost:5174 in VS Code's Simple Browser.",
      "dependsOn": ["Start: Frontend Dev Server", "Open: Frontend Preview"],
      "dependsOrder": "parallel",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Start: ngrok + Sync Webhook URLs",
      "detail": "Open the tunnel, update webhook environment values, and recreate app/worker so they use the new URL.",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Start: ngrok + Sync URLs", "--", "python", "scripts/start-ngrok.py"],
      "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Stop: Docker Stack",
      "detail": "Stop Carameli containers. Named volumes and database data survive.",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Stop: Docker Stack", "--", "python", "scripts/docker-down.py"],
      "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Test: Run Carameli Target — free",
      "detail": "Run a Carameli-only free target. The ordinary full/changed suite is the workspace-level 'Test: Run Suite' task.",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Test: Run Carameli Target", "--", "python", "scripts/run-tests.py", "${input:testSuite}"],
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    },
    {
      "label": "Test: Run Browser E2E — free",
      "detail": "Run Playwright headless, headed, or across Chromium/Firefox/WebKit.",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Test: Run Browser E2E", "--", "python", "scripts/run-e2e.py", "${input:e2eMode}"],
      "group": "test",
      "presentation": { "reveal": "always", "panel": "new", "showReuseMessage": false, "close": false },
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "openFrontendSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": "http://localhost:5174/"
    },
    {
      "id": "testSuite",
      "type": "pickString",
      "description": "Which Carameli-only free target to run",
      "options": [
        { "label": "All free targets (pytest + hooks + frontend)", "value": "--all" },
        { "label": "Frontend (Vitest)", "value": "--target=frontend-tests" },
        { "label": "Vendored harness hooks", "value": "--target=hook-tests" },
        { "label": "Public webhook reachability", "value": "--target=webhook-e2e" }
      ],
      "default": "--all"
    },
    {
      "id": "e2eMode",
      "type": "pickString",
      "description": "Which Playwright mode to run",
      "options": [
        { "label": "Headless", "value": "" },
        { "label": "Headed", "value": "--headed" },
        { "label": "Cross-browser", "value": "--cross-browser" }
      ],
      "default": ""
    }
  ]
}
