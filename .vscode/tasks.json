      "type": "process",
      "command": "python",
      "args": ["../scripts/notify-wrap.py", "Install: Frontend Dependencies", "--", "npm", "install"],
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "showReuseMessage": false,
        "close": false
      },
      "problemMatcher": []
    },
