      "label": "Start: Full Stack (Docker Compose)",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Start: Full Stack", "--", "pwsh", "-ExecutionPolicy", "Bypass", "-File", "scripts/docker-up.ps1", "-Build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "close": false
      },
      "problemMatcher": []
    },
