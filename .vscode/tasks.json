{
  // Label convention: "Domain: Title Case Action". Every task carries a `detail` —
  // that's the second line in the task quick-pick, and it's the only place a
  // one-click action can explain its cost or its blast radius.
  //
  // Variants of one action are folded into a single task with a `${input:...}`
  // picker rather than one palette entry each. The exception is anything that
  // spends money or touches a live provider: those stay separate, unfoldable
  // entries so a paid tier can never be one mis-click away from a free one.
  //
  // Machine-wide Docker recovery (prune / fix stalled Desktop / restart engine)
  // lives in the USER-level tasks.json, not here — it acts on the daemon, not on
  // this project. Those user tasks delegate back to scripts/docker-*.py, which
  // stay in this repo (they're covered by scripts/hooks/tests/ and are what the
  // fix-docker skill reads artifacts from).
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start: Full Stack (Docker Compose)",
      "detail": "Build and start the whole stack, then wait for healthchecks. The default build task (Ctrl+Shift+B).",
      "type": "process",
      "command": "python",
      "args": ["scripts/notify-wrap.py", "Start: Full Stack", "--", "python", "scripts/docker-up.py", "--build"],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Start: Frontend Dev Server",
      "detail": "`npm run dev` in frontend/. Vite HMR needs CHOKIDAR_USEPOLLING on Windows bind mounts.",
      "type": "shell",
      "command": "npm run dev",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "presentation": {
        "reveal": "always",
        "panel": "new",
        "showReuseMessage": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
