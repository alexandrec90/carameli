.env
.env.*
!.env.example
# Template for tests/local_e2e/; the real .env.local-e2e stays ignored by the rule above.
!.env.local-e2e.example

# Secrets / certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
# Ignored with the credential files above, not with the config: an .npmrc is where a
# registry auth token lands. frontend/.npmrc is the exception and is committed — it
# carries `engine-strict` and nothing else, and it has to be in the tree to have any
# effect on CI or on a fresh clone.
.npmrc
!frontend/.npmrc

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root. Unanchored, `lib/` matches a directory of that name at
# any depth, and it did: `frontend/src/tests/lib/` was excluded wholesale, so
# `logger.test.ts` sat on disk passing locally and was never committed or run in CI.
# These two are setuptools build output and only ever appear at the top level.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing / coverage
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.hypothesis/
.benchmarks/
.coverage
.coverage.*
htmlcov/
.testmondata
.testmondata-shm
.testmondata-wal

# Logs
*.log
logs/
reports/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/

# Node / frontend
# The Python-template `lib/` rule above (unanchored) otherwise swallows the
# frontend source `lib/` dir — keep it tracked.
!frontend/src/lib/
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/
.cache/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/

# Coverage outputs
coverage/
coverage.xml
*.lcov
.nyc_output/

# Local/generated material (durable documentation belongs in docs/).
# `.local/` is the single bucket for local-only material — hand-kept diagrams and
# notes live in `.local/charts/`, so there is no separate root-level `charts/`.
artifacts/
.local/

# Workspace metadata
/carameli.code-workspace
/carameli-b.code-workspace

# Ensure any accidental copies of the legacy CRM tree are ignored. That tree is a
# third party's licensed source and must never be committed here.
# Directory-only (note every trailing slash): an unanchored `**/*LegacyCRM*` also
# matches plain files, and because Windows sets core.ignorecase it would silently
# swallow ordinary docs whose names mention the legacy tree.
legacy-crm/
**/legacy-crm/
**/*LegacyCRM*/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Claude Code local settings (personal permissions / preferences)
.claude/settings.local.json

# Ephemeral worktree boxes. These are checkouts of this same repository, created
# and reaped by the global devkit worktree tooling; left untracked they make the
# primary tree permanently dirty, which `scripts/ship.py` refuses to push from.
.claude/worktrees/

# Local Docker Compose overrides
docker-compose.override.yml

# Written into this checkout by a tool outside the repo -- an `AGENTS.md` mirror of the
# root `CLAUDE.md`, search-and-replaced (`.claude/` -> `.Codex/`). Nothing generates it
# and nothing would regenerate it: `sync-codex-context.py` deliberately does not copy
# project instructions, because Codex reads `CLAUDE.md` through
# `project_doc_fallback_filenames`, and devkit deleted its own tracked `AGENTS.md` in
# v0.6.0. A second instruction tree drifts from the first and is the copy nothing tests.
# Ignored rather than merely deleted because an untracked file no `.gitignore` excludes
# is invisible to every gate, so `git add -A` recommitted it twice -- the `sweep: park
# stranded work` commits `bb9d6d6` and `dd7efc5`. Rooted, so a vendored `AGENTS.md`
# deeper in the tree is left alone. Pinned by `tests/unit/test_gitignore_contract.py`.
/AGENTS.md
