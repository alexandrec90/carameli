.env
.env.*
!.env.example
# Template for tests/local_e2e/; the real .env.local-e2e stays ignored by the rule above.
!.env.local-e2e.example

# Secrets / certificates
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
.npmrc

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# Anchored to the repo root. Unanchored, `lib/` matches a directory of that name at
# any depth, and it did: `frontend/src/tests/lib/` was excluded wholesale, so
# `logger.test.ts` sat on disk passing locally and was never committed or run in CI.
# These two are setuptools build output and only ever appear at the top level.
/lib/
/lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
ENV/
env/

# Testing / coverage
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.hypothesis/
.benchmarks/
.coverage
.coverage.*
htmlcov/
.testmondata
.testmondata-shm
.testmondata-wal

# Logs
*.log
logs/
reports/

# OS / editor
.DS_Store
Thumbs.db
Desktop.ini
.idea/

# Node / frontend
# The Python-template `lib/` rule above (unanchored) otherwise swallows the
# frontend source `lib/` dir — keep it tracked.
!frontend/src/lib/
node_modules/
frontend/node_modules/
frontend/.next/
frontend/dist/
frontend/build/
frontend/.vite/
.vite/
.cache/
.eslintcache
.stylelintcache
.turbo/
.parcel-cache/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/

# Coverage outputs
coverage/
coverage.xml
*.lcov
.nyc_output/

# Local/generated material (durable documentation belongs in docs/).
# `.local/` is the single bucket for local-only material — hand-kept diagrams and
# notes live in `.local/charts/`, so there is no separate root-level `charts/`.
artifacts/
.local/

# Workspace metadata
/carameli.code-workspace
/carameli-b.code-workspace

# Ensure any accidental copies of the VanillaLand tree are ignored.
# Directory-only (note every trailing slash): an unanchored `**/*VanillaLand*` also
# matches plain files, and because Windows sets core.ignorecase it silently swallowed
# `docs/reference/vanillaland-scope.md` — prose *about* the legacy tree is exactly what
# this repo wants tracked. Ignore copies of the tree, not writing about it.
VanillaLand/
**/VanillaLand/
**/*VanillaLand*/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# promptfoo eval cache / outputs (keep the dir, ignore the generated artifacts)
.promptfoo/
evals/output/*
!evals/output/.gitkeep
evals/.last-run.json

# Claude Code local settings (personal permissions / preferences)
.claude/settings.local.json

# Local Docker Compose overrides
docker-compose.override.yml
