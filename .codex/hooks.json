{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-hook-adapter.py\" --event SessionStart -- python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-session-start.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-hook-adapter.py\" --event SessionStart -- python3 \"$(git rev-parse --show-toplevel)/scripts/prune-logs.py\" --quiet"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-hook-adapter.py\" --event PreToolUse -- python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/enforce-capped-bash.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|MultiEdit|apply_patch|create_file)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-hook-adapter.py\" --event PostToolUse -- python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/lint-fix.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/codex-hook-adapter.py\" --event Stop -- python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/stop.py\""
          }
        ]
      }
    ]
  }
}
