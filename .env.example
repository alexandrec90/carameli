# dotenv-linter:off UnorderedKey
# (keys are deliberately grouped by topic, not alphabetized)
# Carameli environment variables — copy to .env and fill in real values

# Async PostgreSQL DSN — routes through PgBouncer (transaction pool) in Docker.
# Override DIRECT_DATABASE_URL if you need Alembic to bypass PgBouncer for migrations.
DATABASE_URL=postgresql+asyncpg://carameli:carameli_local_dev@localhost:5432/carameli
DIRECT_DATABASE_URL=postgresql+asyncpg://carameli:carameli_local_dev@localhost:5432/carameli

# Provider selection (default: telnyx / jambonz)
CALL_ENGINE_PROVIDER=jambonz
CARRIER_PROVIDER=telnyx

# Telnyx carrier credentials
TELNYX_API_KEY=
# Messaging Profile ID from the Telnyx portal — required to enable SMS on a DID
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
TELNYX_WEBHOOK_SECRET=
# Set to 1 when running against Telnyx sandbox — reconciliation has no real records to
# diff there, so list_recent_messages returns an empty list instead of calling the API.
TELNYX_SANDBOX=0
# Owned Telnyx DIDs used by the live sandbox SMS tests (tests/integration/
# test_telnyx_sandbox.py). Telnyx has no magic test numbers — the from-number must be
# a real number on the account, assigned to the messaging profile above. The SMS
# sandbox tests are skipped when these are blank.
TELNYX_TEST_FROM_NUMBER=
TELNYX_TEST_TO_NUMBER=

# Jambonz / FreeSWITCH call engine settings
# Required: 32-char random string used by Jambonz to encrypt DB-stored credentials.
# The docker-compose default is fine for local dev; set a real secret in production.
ENCRYPTION_SECRET=carameli-local-dev-encryption-key!
JAMBONZ_ACCOUNT_SID=change_me
JAMBONZ_API_KEY=change_me
JAMBONZ_BASE_URL=http://jambonz:3000
JAMBONZ_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
JAMBONZ_WEBHOOK_SECRET=change_me
JWT_SECRET=carameli-local-dev-jwt-secret-change-me!

# rtpengine — local IP the media (RTP) sockets bind to. Leave as 127.0.0.1 for
# local dev (works out of the box). For real media relay set the host's local IP,
# optionally advertising a public IP for NAT traversal in LOCAL!PUBLIC form,
# e.g. RTPENGINE_LOCAL_IP=10.0.0.5!203.0.113.9
RTPENGINE_LOCAL_IP=127.0.0.1

# SIP TLS + SRTP (Track F — set to "true" to enable; mount certs in ./tls/)
FREESWITCH_SRTP_ENABLE=false
FREESWITCH_TLS_ENABLE=false

# S3-compatible storage for call recordings (Track F)
# Used by both the app and Jambonz to store / retrieve recordings.
# S3_ENDPOINT: blank for real AWS S3; e.g. http://minio:9000 for MinIO
# Default values below use the MinIO container from docker-compose.yml.
S3_ACCESS_KEY_ID=minioadmin
S3_BUCKET=carameli-recordings
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=minioadmin

# Set to "true" to have Jambonz record every call automatically
JAMBONZ_RECORD_ALL_CALLS=false

# Redis — used for distributed locking and APScheduler job store
REDIS_URL=redis://redis:6379

# Per-client rate limits (slowapi, Redis-backed); uses limits library syntax
RATE_LIMIT_CALLS=30/minute
RATE_LIMIT_SMS=60/minute

# Bearer token secret — VanillaSoft sends this in Authorization: Bearer <key>
API_KEY_SECRET=change_me_to_a_long_random_string

# Comma-separated list of origins allowed by CORS (VanillaSoft domains in production)
CORS_ORIGINS=https://vanillasoft.example.com,https://app.vanillasoft.com

# VanillaSoft write-back (leave URL blank to disable)
# URL is the VanillaSoft.CloudliApi base; Carameli POSTs the notify endpoints under it.
# Secret must match the staging appSettings CloudliAuthValue (sent as X-Cloudli-Auth).
VANILLASOFT_WEBHOOK_SECRET=shared-secret
VANILLASOFT_WEBHOOK_URL=https://vs-staging.example.com/cloudliapi

# Reconciliation cron (phase 04): periodically diffs Telnyx/Jambonz records against
# call_events/sms_messages to catch webhooks that never arrived. Default-off; turn on
# only where live provider credentials are configured (the E2E/live environment).
RECONCILIATION_ENABLED=false
RECONCILIATION_LOOKBACK_MINUTES=60
# Path prefix for the notify POSTs: "notify" = legacy fire-and-forget CloudliController,
# "carameli/notify" = honest synchronous CarameliNotifyController (flip only after the
# staging deploy that ships it; flipping back is the rollback).
VANILLASOFT_NOTIFY_PREFIX=notify

# Grafana admin password (default: admin — change in production)
GRAFANA_ADMIN_PASSWORD=admin

# ngrok tunnel URL (auto-set by scripts/start-ngrok.py)
# Used by webhook e2e tests and as the base URL for Telnyx/Jambonz callbacks.
NGROK_URL=

# Live backend E2E suite (tests/live_e2e/, marker live_e2e). Opt-in, costs real money
# (call minutes + SMS), needs live infra. Run: RUN_LIVE_E2E=1 pytest tests/live_e2e -m live_e2e
# The suite skips unless RUN_LIVE_E2E=1 AND every required var below is set.
RUN_LIVE_E2E=
E2E_BASE_URL=http://localhost:8000
# Bearer key + vs_customer_id of a DEDICATED E2E test customer (create once via
# VsCustomer/Add; never reuse a real customer).
E2E_API_KEY=
E2E_CUSTOMER_ID=
# Two owned Canadian test DIDs on the E2E customer; B is the inbound target.
E2E_DID_A=
E2E_DID_B=
# optional 1: also assert VanillaSoft-side via PubApi (belt-and-suspenders vs posted).
E2E_VS_CHECK=
# optional: Telnyx Call Control connection id for unattended call origination.
E2E_TELNYX_CONNECTION_ID=
# optional: extension for the attended (-m manual) click-to-call variant.
E2E_EXTENSION=
# optional 1: run the recording flow (roadmap A6 must be live).
E2E_RECORDING=

# Session cookie signing secret (used by /auth/session)
SESSION_SECRET=change_me_to_a_long_random_string

# Frontend runtime config (Vite dev proxy handles routing in dev)
VITE_API_BASE_URL=http://localhost:8000
