# Carameli environment variables — copy to .env and fill in real values

# Async PostgreSQL DSN for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://carameli:carameli_local_dev@localhost:5432/carameli

# Provider selection (default: twilio / twilio)
CARRIER_PROVIDER=twilio        # or: telnyx
CALL_ENGINE_PROVIDER=twilio    # or: jambonz

# Twilio credentials (use Twilio test credentials for local/dev)
# Test SID always starts with AC...test... — no real charges
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here

# Public base URL for Twilio callbacks (ngrok HTTPS URL when testing webhooks)
TWILIO_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app

# Telnyx (Track B — leave blank when using Twilio)
TELNYX_API_KEY=
TELNYX_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
TELNYX_WEBHOOK_SECRET=

# Jambonz / FreeSWITCH (Track C — leave blank when using Twilio)
JAMBONZ_BASE_URL=http://jambonz:3000
JAMBONZ_API_KEY=change_me
JAMBONZ_ACCOUNT_SID=change_me
JAMBONZ_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
JAMBONZ_WEBHOOK_SECRET=change_me

# rtpengine — set to the machine's public IP for NAT traversal
RTPENGINE_PUBLIC_IP=1.2.3.4

# SIP TLS + SRTP (Track F — set to "true" to enable; mount certs in ./tls/)
FREESWITCH_TLS_ENABLE=false
FREESWITCH_SRTP_ENABLE=false

# S3-compatible storage for call recordings (Track F)
# Used by both the app and Jambonz to store / retrieve recordings.
S3_BUCKET=carameli-recordings
S3_ENDPOINT=                        # blank for real AWS S3; e.g. http://minio:9000 for MinIO
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1

# Set to "true" to have Jambonz record every call automatically
JAMBONZ_RECORD_ALL_CALLS=false

# Bearer token secret — VanillaSoft sends this in Authorization: Bearer <key>
API_KEY_SECRET=change_me_to_a_long_random_string

# Comma-separated list of origins allowed by CORS (VanillaSoft domains in production)
CORS_ORIGINS=https://vanillasoft.example.com,https://app.vanillasoft.com

# VanillaSoft call write-back webhook (leave blank to disable)
VANILLASOFT_WEBHOOK_URL=https://vs.example.com/api/voip/call-complete
VANILLASOFT_WEBHOOK_SECRET=shared-secret

# Frontend runtime config
VITE_API_BASE_URL=http://localhost:8000
VITE_API_KEY=change_me_to_a_long_random_string
