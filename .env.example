# dotenv-linter:off UnorderedKey
# (keys are deliberately grouped by topic, not alphabetized)
# Carameli environment variables — copy to .env and fill in real values

# --- Docker Compose stack identity (parallel worktrees) ---
# Compose reads these at `docker compose` time (they are not app settings).
# COMPOSE_PROJECT_NAME names the stack's containers/volumes/network AND tags the
# app image (carameli-app-<project>); keep it equal to the checkout's directory
# name. COMPOSE_PROFILES=telephony starts the Jambonz/FreeSWITCH/rtpengine
# services — required in the primary checkout, and must be OMITTED in secondary
# worktree stacks (rtpengine's host networking allows one instance per machine).
# Secondary worktrees also uncomment the *_HOST_PORT offsets so both stacks can
# run at once. Full guide: README.md, "Parallel Worktrees" section.
COMPOSE_PROJECT_NAME=carameli
COMPOSE_PROFILES=telephony
# APP_HOST_PORT=8001
# FRONTEND_HOST_PORT=5174
# DB_HOST_PORT=5433
# REDIS_HOST_PORT=6380
# MINIO_HOST_PORT=9002
# MINIO_CONSOLE_HOST_PORT=9003

# Async PostgreSQL DSN — routes through PgBouncer (transaction pool) in Docker.
# Override DIRECT_DATABASE_URL if you need Alembic to bypass PgBouncer for migrations.
DATABASE_URL=postgresql+asyncpg://carameli:carameli_local_dev@localhost:5432/carameli
DIRECT_DATABASE_URL=postgresql+asyncpg://carameli:carameli_local_dev@localhost:5432/carameli

# Provider selection (default: telnyx / jambonz)
CALL_ENGINE_PROVIDER=jambonz
CARRIER_PROVIDER=telnyx

# Telnyx carrier credentials
TELNYX_API_KEY=
# Messaging Profile ID from the Telnyx portal — required to enable SMS on a DID
TELNYX_MESSAGING_PROFILE_ID=
TELNYX_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
TELNYX_WEBHOOK_SECRET=
# Set to 1 when running against Telnyx sandbox — reconciliation has no real records to
# diff there, so list_recent_messages returns an empty list instead of calling the API.
TELNYX_SANDBOX=0
# Owned Telnyx DIDs used by the live sandbox SMS tests (tests/integration/
# test_telnyx_sandbox.py). Telnyx has no magic test numbers — the from-number must be
# a real number on the account, assigned to the messaging profile above. The SMS
# sandbox tests are skipped when these are blank.
TELNYX_TEST_FROM_NUMBER=
TELNYX_TEST_TO_NUMBER=

# Jambonz / FreeSWITCH call engine settings
# Required: 32-char random string used by Jambonz to encrypt DB-stored credentials.
# The docker-compose default is fine for local dev; set a real secret in production.
ENCRYPTION_SECRET=carameli-local-dev-encryption-key!
JAMBONZ_ACCOUNT_SID=change_me
JAMBONZ_API_KEY=change_me
JAMBONZ_BASE_URL=http://jambonz:3000
JAMBONZ_WEBHOOK_BASE_URL=https://your-ngrok-subdomain.ngrok-free.app
JAMBONZ_WEBHOOK_SECRET=change_me
JWT_SECRET=carameli-local-dev-jwt-secret-change-me!
# Encrypts generated SIP passwords while they await one-time AccountData delivery.
# Use a separate random secret of at least 32 characters.
SIP_CREDENTIAL_ENCRYPTION_SECRET=change_me_to_an_independent_32_char_secret

# rtpengine — local IP the media (RTP) sockets bind to. Leave as 127.0.0.1 for
# local dev (works out of the box). For real media relay set the host's local IP,
# optionally advertising a public IP for NAT traversal in LOCAL!PUBLIC form,
# e.g. RTPENGINE_LOCAL_IP=10.0.0.5!203.0.113.9
RTPENGINE_LOCAL_IP=127.0.0.1

# SIP TLS + SRTP (Track F — set to "true" to enable; mount certs in ./tls/)
FREESWITCH_SRTP_ENABLE=false
FREESWITCH_TLS_ENABLE=false

# S3-compatible storage for call recordings (Track F)
# Used by both the app and Jambonz to store / retrieve recordings.
# S3_ENDPOINT: blank for real AWS S3; e.g. http://minio:9000 for MinIO
# Default values below use the MinIO container from docker-compose.yml.
S3_ACCESS_KEY_ID=minioadmin
S3_BUCKET=carameli-recordings
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=minioadmin

# PostgreSQL backups — the db-backup sidecar runs once on startup, then at this
# interval. It keeps the newest BACKUP_KEEP_COUNT custom-format dumps. Use separate
# credentials and an external S3 endpoint in production; provision the bucket first.
BACKUP_DATABASE_PASSWORD=carameli_local_dev
BACKUP_INTERVAL_SECONDS=86400
BACKUP_KEEP_COUNT=14
BACKUP_S3_ACCESS_KEY_ID=minioadmin
BACKUP_S3_BUCKET=carameli-backups
BACKUP_S3_ENDPOINT=http://minio:9000
BACKUP_S3_SECRET_ACCESS_KEY=minioadmin

# Bound asynchronous recording ZIP work by count and uncompressed source bytes.
RECORDING_ARCHIVE_MAX_FILES=500
RECORDING_ARCHIVE_MAX_FILE_BYTES=104857600
RECORDING_ARCHIVE_MAX_TOTAL_BYTES=1073741824

# Shared retention window for posted call_events, posted sms_messages, and recordings.
# 0 disables all retention (the default). Recommended production value: 450 (~15 months).
# Keep this value aligned with the lifecycle rule on a real AWS S3 recordings bucket;
# configure an Expiration action for current objects after the same number of days in
# S3 Console > bucket > Management > Lifecycle rules. The local MinIO init service
# applies/removes the equivalent rule automatically when it is re-run.
RETENTION_DAYS=0

# Set to "true" to have Jambonz record every call automatically
JAMBONZ_RECORD_ALL_CALLS=false

# Carrier trunk that device-originated PSTN calls are pinned to, named exactly as
# the carrier is named in Jambonz. Leave blank to let Jambonz select, which is what
# you want while the account has a single carrier configured.
# Outbound calls from a registered softphone also require the Jambonz account's
# "application for SIP device calls" to point at the Carameli application; without
# it Jambonz has nothing to route the call to and rejects it with SIP 480.
JAMBONZ_OUTBOUND_TRUNK=

# Redis — used for distributed locking and APScheduler job store
REDIS_URL=redis://redis:6379

# Base URL for dead-man pings. A per-job slug is appended (for example
# /call-event-retry or /backup). Leave blank to disable heartbeats.
HEARTBEAT_URL=

# Per-client rate limits (slowapi, Redis-backed); uses limits library syntax
RATE_LIMIT_CALLS=30/minute
RATE_LIMIT_SMS=60/minute

# Bearer token secret — VanillaSoft sends this in Authorization: Bearer <key>
API_KEY_SECRET=change_me_to_a_long_random_string

# Comma-separated list of origins allowed by CORS (VanillaSoft domains in production)
CORS_ORIGINS=https://vanillasoft.example.com,https://app.vanillasoft.com

# VanillaSoft write-back (leave URL blank to disable)
# URL is the VanillaSoft.VoipApi base; Carameli POSTs the notify endpoints under it.
# Shared secret accepted by Carameli's legacy /vs-log receiver. It is not sent on
# Carameli notify POSTs and is deliberately separate from Carameli's signing key.
VANILLASOFT_WEBHOOK_SECRET=shared-secret
VANILLASOFT_WEBHOOK_URL=https://vs-staging.example.com/voip
# Carameli's OWN signing key for outbound notify POSTs (X-Carameli-Signature:
# t=<unix>,v1=<hex hmac-sha256 of "<t>." + body>). Separate from the legacy vendor's
# shared secret above on purpose — one static value across two vendors means rotating
# either rotates both. Required when VanillaSoft write-back is enabled; must match the
# VanillaSoft.VoipApi appSetting CarameliNotifySecret.
CARAMELI_NOTIFY_SECRET=carameli-notify-secret

# Reconciliation cron (phase 04): periodically diffs Telnyx/Jambonz records against
# call_events/sms_messages to catch webhooks that never arrived. Default-off; turn on
# only where live provider credentials are configured (the E2E/live environment).
RECONCILIATION_ENABLED=false
RECONCILIATION_LOOKBACK_MINUTES=60
# Path prefix for the notify POSTs: "notify" = legacy fire-and-forget CloudliController,
# "carameli/notify" = honest synchronous CarameliNotifyController (flip only after the
# staging deploy that ships it; flipping back is the rollback).
VANILLASOFT_NOTIFY_PREFIX=notify

# Connectivity probe (scripts/probe-connectivity.py) — read-only, not app settings.
# The probe derives its target host from VANILLASOFT_WEBHOOK_URL above; override the
# host here, and set the DB host when SQL Server lives on a separate box from the app.
VS_PROBE_HOST=
VS_PROBE_DB_HOST=

# Grafana admin password (default: admin — change in production)
GRAFANA_ADMIN_PASSWORD=admin
# Generic Alertmanager receiver. Point this at the operator's paging bridge.
ALERTMANAGER_WEBHOOK_URL=http://host.docker.internal:9099/alerts

# Error tracking (Sentry SaaS or any Sentry-compatible backend such as GlitchTip).
# Leave the DSN blank to disable error tracking. Tracing stays off by default.
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0

# Public ngrok URL (auto-set by scripts/start-ngrok.py). Free ngrok accounts get
# one stable, assigned dev domain; `ngrok http 8000` reuses it on every run.
# Used by webhook E2E tests and as the base URL for Telnyx/Jambonz callbacks.
NGROK_URL=

# Live backend E2E suite (tests/live_e2e/, marker live_e2e). Opt-in, costs real money
# (call minutes + SMS), needs live infra. Run: RUN_LIVE_E2E=1 pytest tests/live_e2e -m live_e2e
# The suite skips unless RUN_LIVE_E2E=1 AND every required var below is set.
RUN_LIVE_E2E=
E2E_BASE_URL=http://localhost:8000
# Bearer key + vs_customer_id of a DEDICATED E2E test customer (create once via
# POST /vsapi/1.0.0/VsCustomer/Create; never reuse a real customer).
E2E_API_KEY=
E2E_CUSTOMER_ID=
# Two owned Canadian test DIDs on the E2E customer; B is the inbound target.
E2E_DID_A=
E2E_DID_B=
# optional 1: also assert VanillaSoft-side via PubApi (belt-and-suspenders vs posted).
# Requires E2E_PUBAPI_BASE_URL + E2E_PUBAPI_KEY below; the suite skips without them.
# Applies to the ATTENDED click-to-call test only (-m manual): nothing on the
# VanillaSoft side creates a call-history record from a Carameli notification, so the
# unattended flow has nothing for GetCallHistory to return and keeps posted=True as its
# assertion. See docs/operations/diagnostics-error-map.md.
E2E_VS_CHECK=
E2E_PUBAPI_BASE_URL=
E2E_PUBAPI_KEY=
# optional: restrict the PubApi call-history read to a single VanillaSoft project.
E2E_PUBAPI_PROJECT_ID=
# optional: Telnyx Call Control connection id for unattended call origination.
E2E_TELNYX_CONNECTION_ID=
# optional: extension for the attended (-m manual) click-to-call variant.
E2E_EXTENSION=
# optional 1: run the recording flow (roadmap A6 must be live).
E2E_RECORDING=

# Session cookie signing secret (used by /auth/session)
SESSION_SECRET=change_me_to_a_long_random_string

# Frontend runtime config (Vite dev proxy handles routing in dev)
VITE_API_BASE_URL=http://localhost:8000
