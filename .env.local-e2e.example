# Configuration for the local integration suite (tests/local_e2e/).
#
# Copy to `.env.local-e2e` at the repo root and fill in. That file is git-ignored: it
# holds two shared secrets and the tunnel URLs for one machine's setup.
#
# This suite is for the INVERTED topology — Carameli running remotely behind a tunnel,
# LegacyCRM running locally in IIS. It is free (no telephony) and safe to re-run.
# See docs/operations/local-integration-testing.md for the full runbook.

# --- gate -----------------------------------------------------------------------------
# Nothing runs without this. Every test skips with a reason instead.
RUN_LOCAL_E2E=1

# --- remote Carameli ------------------------------------------------------------------
# Public base URL of the remote stack, no trailing slash and no path. The suite appends
# /health, /api/v1/... and /vsapi/1.0.0/... itself.
CARAMELI_BASE_URL=https://your-tunnel.ngrok-free.dev

# Bearer key for a DEDICATED E2E customer — do not reuse a real customer's key.
CARAMELI_API_KEY=

# That customer's vs_customer_id. Must also be a real CustomerID in the local
# CRM database, because the notify tests insert call rows against it.
CARAMELI_VS_CUSTOMER_ID=

# --- local LegacyCRM ----------------------------------------------------------------
# The VoIP receiver's application root in local IIS. The suite appends
# /carameli/notify/... `/voip` is the vendor-neutral alias; the legacy `/legacy vendor` alias
# points at the same application and also works.
VS_LOCAL_BASE_URL=http://localhost:8021/voip

# Must equal CARAMELI_NOTIFY_SECRET on the remote AND the CarameliNotifySecret appSetting
# in AppCode/<legacy-voip-api>/Web.config. An empty appSetting rejects everything
# with 401, which is indistinguishable from a wrong secret.
VS_CARAMELI_NOTIFY_SECRET=

# Absolute path to the LegacyCRM checkout. Read only by `scripts/local-e2e.py`, which
# boots the CRM side from `<VS_REPO_DIR>\.local\carameli-e2e\start.ps1` and runs
# the outbound driver at `<VS_REPO_DIR>\AppCode\CarameliE2EDriver\run.ps1` when that
# exists. The pytest suite never reads it: without this key `python scripts/local-e2e.py`
# cannot start IIS/SQL/Elasticsearch, but `pytest tests/local_e2e` against an
# already-running stack is unaffected.
VS_REPO_DIR=C:\path\to\LegacyCRM

# --- optional: the reverse direction --------------------------------------------------
# Public tunnel pointing at the same local IIS site as VS_LOCAL_BASE_URL. Without it, the
# tests that prove the REMOTE can deliver a notify here skip rather than fail.
VS_PUBLIC_BASE_URL=

# The remote's CRM_WEBHOOK_SECRET. Enables the /webhooks/vs-log ingestion test.
VS_WEBHOOK_SECRET=

# --- optional: local log channel ------------------------------------------------------
# Where NLog ships CRM's logs; defaults shown.
ES_INDEX=crm_dev.events
ES_URL=http://localhost:9200

# --- optional: seeding the field-contract fixtures --------------------------------------
# Read only by `scripts/local-e2e.py`. Two tests assert the field shape of
# /api/v1/extensions and /api/v1/phone-lines and can only do so against a row that
# exists; the script seeds one of each straight into Postgres, because the API routes
# that would create them buy a real DID and provision a real SIP endpoint.
#
# Set this to the Compose project running that database when it is NOT the project this
# checkout resolves to by default — an ephemeral worktree has its own
# COMPOSE_PROJECT_NAME, so `docker compose exec db` from inside one reports
# `service "db" is not running` while the suite tests the static checkout's stack over
# HTTP. Leave empty when running from the checkout that owns the stack. Leave empty too
# when Carameli is remote: the seed then skips and the two tests skip with it.
CARAMELI_COMPOSE_PROJECT=
